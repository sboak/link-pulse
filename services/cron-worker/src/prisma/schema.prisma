generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Link {
  id        String   @id @default(cuid())
  code      String   @unique
  url       String
  createdAt DateTime @default(now())
  clicks    Click[]
  rollups   ClickRollup[]
}

model Click {
  id        String   @id @default(cuid())
  linkId    String
  link      Link     @relation(fields: [linkId], references: [id], onDelete: Cascade)
  referrer  String?
  timestamp DateTime @default(now())

  @@index([linkId, timestamp])
}

model ClickRollup {
  id          String   @id @default(cuid())
  linkId      String
  link        Link     @relation(fields: [linkId], references: [id], onDelete: Cascade)
  bucket      DateTime
  granularity String
  count       Int

  @@unique([linkId, bucket, granularity])
  @@index([linkId])
}
